# Server Configuration
PORT=5000

# MongoDB Connection String (from MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/room_budget?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL for CORS (allow requests from your deployed frontend)
# In development: http://localhost:5173
# In production: https://your-frontend-domain.vercel.app
BASE_URL=http://localhost:5173

# Secret code required during registration to register as Admin
ADMIN_SECRET_CODE=FIRSTPROJECT
