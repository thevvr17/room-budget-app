# Backend API Base URL
# In local development: leave empty to use Vite proxy (/api) or set to http://localhost:5000/api
# In production: https://your-backend-service.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Socket.IO Server URL
# In local development: http://localhost:5000
# In production: https://your-backend-service.onrender.com
VITE_SOCKET_URL=http://localhost:5000
